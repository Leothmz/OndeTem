# Copie para `.env` (ignorado pelo git) ou exporte no shell antes de `npm start`.
# Sem credencial TMDB a API usa o catálogo local de demonstração.

# Credencial TMDB (somente no servidor). Use UMA das duas:
TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=

# Idioma e região das consultas TMDB.
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR
TMDB_TIMEOUT_MS=5000
# Opcional: outra base da API v3 (proxy corporativo, mock local). Padrão: https://api.themoviedb.org/3
# TMDB_API_BASE_URL=

# Cache em memória das respostas TMDB (0 desativa).
CATALOG_CACHE_TTL_SECONDS=600
CATALOG_CACHE_MAX_ENTRIES=500

# Endereço da API. O proxy do `ng serve` usa a mesma porta.
API_HOST=127.0.0.1
API_PORT=3000
